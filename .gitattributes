# 统一换行符：文本文件入库与检出一律 LF，根治 Windows/跨平台行尾 churn
* text=auto eol=lf

# 二进制产物不做换行转换
*.bit  binary
*.bin  binary
*.dcp  binary
*.xsa  binary
*.png  binary
*.jpg  binary

# 上游原样文件与 diff 证据不参与空白检查：
#   vendor/ 为 EEMBC 官方源码原样入库（禁止改动，含上游自带尾随空格）
#   *.patch 为 unified diff 证据（空白上下文行会被 git diff --check 误报）
src/riscv_fw/coremark/vendor/** -whitespace
*.patch -whitespace

# Module-one Vivado archives retain the tool's original table padding.
data/logs/2026-10-07-partC-postopt/** -whitespace
data/logs/2026-10-07-partC-postopt/*.md whitespace
build/reports/soc_40mhz_bht2/** -whitespace

# Archived Pi terminal output retains original CR/control characters.
data/logs/2026-10-06-pi-boot/*.txt -whitespace
data/logs/2026-10-06-pi-boot/*.log -whitespace
data/logs/2026-10-06-pi-pynq/*.txt -whitespace
data/logs/2026-10-06-pi-pynq/*.log -whitespace
data/logs/2026-10-07-pi-pynq/*.txt -whitespace
data/logs/2026-10-07-pi-pynq/*.log -whitespace
