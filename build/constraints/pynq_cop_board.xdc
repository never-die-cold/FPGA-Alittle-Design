# PYNQ-Z2 PL-only pins; PS DDR/FIXED_IO are supplied by the processing_system7 preset.
set_property -dict {PACKAGE_PIN R14 IOSTANDARD LVCMOS33} [get_ports {led[0]}]
set_property -dict {PACKAGE_PIN P14 IOSTANDARD LVCMOS33} [get_ports {led[1]}]
set_property -dict {PACKAGE_PIN N16 IOSTANDARD LVCMOS33} [get_ports {led[2]}]
set_property -dict {PACKAGE_PIN M14 IOSTANDARD LVCMOS33} [get_ports {led[3]}]
set_false_path -to [get_ports {led[*]}]

# FCLK0=100 MHz and FCLK1=40 MHz are generated by PS7 and intentionally asynchronous.
set ps_clock [get_clocks -quiet -of_objects [get_pins -hier -filter {NAME =~ *ps7*/FCLK_CLK0}]]
set cop_clock [get_clocks -quiet -of_objects [get_pins -hier -filter {NAME =~ *ps7*/FCLK_CLK1}]]
if {[llength $ps_clock] != 1 || [llength $cop_clock] != 1} {
    error "Expected exactly one PS 100 MHz and one coprocessor 40 MHz clock"
}
if {abs([get_property PERIOD $ps_clock]-10.000)>0.001 ||
    abs([get_property PERIOD $cop_clock]-25.000)>0.001} {
    error "PS/cop clock periods do not match the 100/40 MHz profile"
}
set_clock_groups -asynchronous -group $ps_clock -group $cop_clock
