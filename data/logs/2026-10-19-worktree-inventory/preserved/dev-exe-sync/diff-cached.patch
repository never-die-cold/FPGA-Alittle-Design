+    );
+    task check; input ok; begin checks=checks+1; if (ok !== 1'b1) begin
+        $display("FAIL: ID+EX case %0d", checks); $fatal(1); end end endtask
+    task check_branch;
+        input [31:0] branch_instr, lhs, rhs; input expected;
