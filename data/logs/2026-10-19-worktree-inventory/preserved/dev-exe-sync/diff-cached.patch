+#   bash sim/scripts/run_iverilog.sh fwd      # 当前核转发专项；历史 v0 对照在 partA-v0 留存
+#   bash sim/scripts/run_iverilog.sh v1_fwd       # CoreMark：转发开、BHT 关
+#   bash sim/scripts/run_iverilog.sh v1_nofwd     # CoreMark：转发关、BHT 关
