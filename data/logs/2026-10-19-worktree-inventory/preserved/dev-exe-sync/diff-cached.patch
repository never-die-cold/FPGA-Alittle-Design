+#   bash sim/scripts/run_iverilog.sh coprocessor [all|pipeline|conv|network] # CNN 算子/全网逐元素对拍
+# 前置：PATH 中含 iverilog / vvp；原验收 13.0，本轮 Linux 11.0 结果另记
+set -u
+
+MODE="${1:-all}"
