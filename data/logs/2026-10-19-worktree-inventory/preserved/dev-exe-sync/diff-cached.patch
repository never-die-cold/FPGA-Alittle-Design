+`timescale 1ns/1ps
+// C02 full-network operator controller, not the C03 MMIO/DMA/firmware wrapper.
+// External ROI/ping/pong/parameter/weight banks: synchronous 1-cycle reads.
+// Banks share reset; model and ROI are immutable for the complete busy window.
+module cnn_sequencer (
+    input wire clk, rst_n, ce, start,
+    input wire [7:0] min_margin,
+    input wire [31:0] cycle_limit,
+    output wire ready,
+    output reg busy, done, error,
+    output reg [2:0] error_layer,
+    output reg [31:0] cycles,
+    output reg [1:0] result_class,
+    output reg [7:0] result_margin,
+    output reg [14:0] result_score,
+    output reg result_low_conf,
+    output reg [23:0] result_logits,
+    output wire memory_enable, weight_enable, parameter_enable,
+    output wire [1:0] read_bank,
+    output wire [15:0] read_address, weight_address,
+    output wire [7:0] parameter_address,
+    input wire [63:0] input_data,
+    input wire [1023:0] weight_data,
+    input wire [511:0] bias_data, multiplier_data,
+    input wire [95:0] shift_data,
+    output wire write_enable,
+    output wire [1:0] write_bank,
+    output wire [15:0] write_address,
+    output wire [63:0] write_data
+);
+    localparam IDLE=0, LAYER_START=1, LAYER_WAIT=2, GAP_REQ=3, GAP_USE=4, GAP_WRITE=5, RESULT=6;
+    reg [2:0] state, layer;
+    reg [31:0] limit, limit_last;
+    reg [7:0] margin_threshold;
+    reg [10:0] gap_index;
+    reg [255:0] gap_sums;
+    reg [23:0] logits;
+    reg [6:0] ci,co,h,w;
+    reg [1:0] kernel,stride,padding,in_bank,out_bank;
+    reg [15:0] weight_base;
+    reg [7:0] param_base;
+    wire engine_ready, engine_busy, engine_done, engine_error;
+    wire engine_read, engine_parameter, engine_write;
+    wire [31:0] engine_cycles;
+    wire [15:0] engine_input_address,engine_weight_address,engine_write_address;
+    wire [63:0] engine_write_data;
+    wire [1:0] engine_block,classification;
+    wire [7:0] margin;
+    wire [14:0] score;
+    wire low_conf,classification_error;
+    wire [63:0] gap_results;
+    wire [7:0] gap_errors;
+    wire permitted;
+    assign ready=ce && !busy;
+    assign permitted=rst_n && busy && cycles < limit_last;
+    always @* begin
+        ci=1; co=16; h=64; w=64; kernel=3; stride=2; padding=1;
+        in_bank=0; out_bank=2; weight_base=0; param_base=0;
+        case(layer)
+            1: begin ci=16; co=32; h=32; w=32; stride=1; in_bank=2; out_bank=1; weight_base=9; param_base=16; end
+            2: begin ci=32; co=32; h=32; w=32; in_bank=1; out_bank=2; weight_base=45; param_base=48; end
+            3: begin ci=32; co=64; h=16; w=16; stride=1; in_bank=2; out_bank=1; weight_base=117; param_base=80; end
+            4: begin ci=64; co=3; h=1; w=1; kernel=1; stride=1; padding=0; in_bank=3; out_bank=2; weight_base=261; param_base=144; end
+            default: begin end
+        endcase
+    end
+    conv_engine engine (.clk(clk),.rst_n(rst_n),.ce(ce),.abort(!permitted),
+        .start(state==LAYER_START && permitted),.cfg_ci(ci),.cfg_co(co),.cfg_width(w),.cfg_height(h),
+        .cfg_kernel(kernel),.cfg_stride(stride),.cfg_padding(padding),.cfg_relu(layer!=4),
+        .cfg_cycle_limit(limit),.ready(engine_ready),.busy(engine_busy),.done(engine_done),.error(engine_error),
+        .cycles(engine_cycles),.memory_enable(engine_read),.input_address(engine_input_address),
+        .weight_address(engine_weight_address),.input_data(input_data),.weight_data(weight_data),
+        .parameter_enable(engine_parameter),.output_block(engine_block),.bias_data(bias_data),
+        .multiplier_data(multiplier_data),.shift_data(shift_data),.write_enable(engine_write),
+        .write_address(engine_write_address),.write_data(engine_write_data));
+    assign memory_enable=permitted && ce && (state==GAP_REQ || engine_read);
+    assign weight_enable=permitted && engine_read;
+    assign parameter_enable=permitted && engine_parameter;
+    assign read_bank=state==GAP_REQ || state==GAP_USE ? 2'd1 : in_bank;
+    assign read_address=state==GAP_REQ || state==GAP_USE ? {5'd0,gap_index} : engine_input_address;
+    assign weight_address=weight_base+engine_weight_address;
+    assign parameter_address=param_base+engine_block*16;
+    assign write_enable=permitted && ce && ((state==GAP_WRITE && !(|gap_errors)) || engine_write);
+    assign write_bank=state==GAP_WRITE ? 2'd3 : out_bank;
+    assign write_address=state==GAP_WRITE ? {13'd0,gap_index[10:8]} : engine_write_address;
+    assign write_data=state==GAP_WRITE ? gap_results : engine_write_data;
+    genvar i;
+    generate for(i=0;i<8;i=i+1) begin: gap_lanes
+        int8_gap average (.total(gap_sums[i*32 +: 32]),.result(gap_results[i*8 +: 8]),.error(gap_errors[i]));
+    end endgenerate
+    int8_logits classify (.logits(logits),.min_margin(margin_threshold),.class_id(classification),
+        .margin_q(margin),.score_q15(score),.low_conf(low_conf),.error(classification_error));
+    integer lane;
+    always @(posedge clk or negedge rst_n) begin
+        if(!rst_n) begin
+            state<=IDLE; layer<=0; busy<=0; done<=0; error<=0; cycles<=0; error_layer<=0;
+            limit<=0; limit_last<=0; margin_threshold<=0; gap_index<=0; gap_sums<=0; logits<=0;
+            result_class<=3; result_margin<=0; result_score<=0; result_low_conf<=1; result_logits<=0;
+        end else begin
+            if(busy) cycles<=cycles+1;
+            if(busy && cycles>=limit_last) begin busy<=0; done<=0; error<=1; error_layer<=7; state<=IDLE; end
+            else if(ce) case(state)
+                IDLE: if(start) begin
+                    done<=0; error<=0; cycles<=0; layer<=0; error_layer<=0; logits<=0;
+                    result_class<=3; result_margin<=0; result_score<=0; result_low_conf<=1; result_logits<=0;
+                    margin_threshold<=min_margin; limit<=cycle_limit;
+                    limit_last<=cycle_limit-32'd1;
+                    if(cycle_limit==0) error<=1;
+                    else begin busy<=1; state<=LAYER_START; end
+                end
+                LAYER_START: if(engine_ready) state<=LAYER_WAIT;
+                LAYER_WAIT: if(engine_error) begin
+                    busy<=0; done<=0; error<=1; error_layer<=layer; state<=IDLE;
+                end else if(engine_done) begin
+                    if(layer==3) begin gap_index<=0; gap_sums<=0; state<=GAP_REQ; end
+                    else if(layer==4) state<=RESULT;
+                    else begin layer<=layer+1; state<=LAYER_START; end
+                end
+                GAP_REQ: state<=GAP_USE;
+                GAP_USE: begin
+                    if(input_data & 64'h8080808080808080) begin
+                        busy<=0; done<=0; error<=1; error_layer<=5; state<=IDLE;
+                    end else begin
+                        for(lane=0;lane<8;lane=lane+1)
+                            gap_sums[lane*32 +: 32]<=gap_sums[lane*32 +: 32]+input_data[lane*8 +: 8];
+                        if(gap_index[7:0]==255) state<=GAP_WRITE;
+                        else begin gap_index<=gap_index+1; state<=GAP_REQ; end
+                    end
+                end
+                GAP_WRITE: if(|gap_errors) begin
+                    busy<=0; done<=0; error<=1; error_layer<=5; state<=IDLE;
+                end else if(gap_index==2047) begin layer<=4; state<=LAYER_START; end
+                else begin gap_index<=gap_index+1; gap_sums<=0; state<=GAP_REQ; end
+                RESULT: if(classification_error) begin
+                    busy<=0; done<=0; error<=1; error_layer<=4; state<=IDLE;
+                end else begin
+                    result_class<=classification; result_margin<=margin; result_score<=score;
+                    result_low_conf<=low_conf; result_logits<=logits; busy<=0; done<=1; state<=IDLE;
+                end
+                default: begin busy<=0; done<=0; error<=1; error_layer<=7; state<=IDLE; end
+            endcase
+            if(permitted && engine_write && ce && layer==4) logits<=engine_write_data[23:0];
+        end
+    end
+endmodule
diff --git a/data/logs/cnn-ooc-1cefffc05185438195b8803d87fc11df/inputs/conv_engine.v b/data/logs/cnn-ooc-1cefffc05185438195b8803d87fc11df/inputs/conv_engine.v
new file mode 100644
index 0000000..4ce1409
--- /dev/null
+++ b/data/logs/cnn-ooc-1cefffc05185438195b8803d87fc11df/inputs/conv_engine.v
@@ -0,0 +1,227 @@
+`timescale 1ns/1ps
+// One outstanding, synchronous 1-cycle BRAM read; ce stalls the operator.
+// Memory/parameter banks must share reset and remain immutable while busy.
+// Writes are intermediate data: usable only after done && !error.
+module conv_engine (
+    input wire clk, rst_n, ce, start, abort,
+    input wire [6:0] cfg_ci, cfg_co, cfg_width, cfg_height,
+    input wire [1:0] cfg_kernel, cfg_stride, cfg_padding,
+    input wire cfg_relu,
+    input wire [31:0] cfg_cycle_limit,
+    output wire ready,
+    output reg busy, done, error,
+    output reg [31:0] cycles,
+    output wire memory_enable,
+    output reg [15:0] input_address, weight_address,
+    input wire [63:0] input_data,
+    input wire [1023:0] weight_data,
+    output wire parameter_enable,
+    output wire [1:0] output_block,
+    input wire [511:0] bias_data, multiplier_data,
+    input wire [95:0] shift_data,
+    output wire write_enable,
+    output wire [15:0] write_address,
+    output wire [63:0] write_data
+);
+    localparam IDLE=0, PARAM_REQ=1, PARAM_USE=2, READ_REQ=3, MAC_USE=4,
+               QUANT=5, WRITE_LOW=6, WRITE_HIGH=7, ADVANCE=8, QUANT_WAIT=10,
+               GEOMETRY=11, ADDRESS_USE=12, SETUP=13;
+    reg [3:0] state;
+    reg [6:0] ci, co, width, height, ow, oh;
+    reg [1:0] kernel, stride, padding, ob;
+    reg [3:0] ib, blocks;
+    reg [1:0] ky, kx;
+    reg [6:0] oy, ox;
+    reg relu;
+    reg [31:0] limit_last;
+    reg [511:0] accumulators, multipliers, bias_latched;
+    reg [95:0] shifts;
+    reg [127:0] quantized;
+    wire [511:0] next_accumulators, sum_accumulators;
+    wire [15:0] mac_overflow, sum_overflow, active_outputs;
+    wire [15:0] quant_results;
+    wire mac_valid;
+    wire [1:0] quant_valid, quant_errors;
+    reg mac_issue;
+    reg [2:0] mac_pending, q_send, q_receive;
+    wire [63:0] activations;
+    reg padding_pixel;
+    reg signed [8:0] iy, ix;
+    reg [8:0] input_row;
+    reg [5:0] weight_row;
+    reg [12:0] plane_words;
+    reg [15:0] pixel_row, block_base, output_address_low;
+    function [7:0] output_size;
+        input [6:0] size;
+        input [1:0] k, s, p;
+        reg [7:0] span;
+        begin
+            // Launch validation rejects size+2*p<k; legal spans are unsigned.
+            span = {1'b0,size}+{5'd0,p,1'b0}-{6'd0,k};
+            output_size = s == 2'd2 ? (span >> 1)+8'd1 : span+8'd1;
+        end
+    endfunction
+    assign ready = ce && !busy && !abort;
+    assign output_block = ob;
+    assign active_outputs = co >= ob*16+16 ? 16'hffff : (16'h1 << (co-ob*16))-1;
+    assign activations = padding_pixel ? 64'd0 : ci == 1 ? {56'd0,input_data[7:0]} : input_data;
+    assign memory_enable = rst_n && ce && busy && state == READ_REQ && cycles < limit_last;
+    assign parameter_enable = rst_n && ce && busy && state == PARAM_REQ && cycles < limit_last;
+    assign write_enable = rst_n && ce && busy && cycles < limit_last
+                       && (state == WRITE_LOW || state == WRITE_HIGH);
+    assign write_address = output_address_low+(state==WRITE_HIGH ? plane_words : 13'd0);
+    assign write_data = state == WRITE_HIGH ? quantized[127:64] : quantized[63:0];
+    always @* begin
+        iy = $signed({2'd0,oy})*(stride==2 ? 9'sd2 : 9'sd1)+$signed({7'd0,ky})-$signed({7'd0,padding});
+        ix = $signed({2'd0,ox})*(stride==2 ? 9'sd2 : 9'sd1)+$signed({7'd0,kx})-$signed({7'd0,padding});
+    end
+    // A read is followed by its MAC launch on the next enabled edge.
+    always @(posedge clk or negedge rst_n) begin
+        if(!rst_n) mac_issue<=0;
+        else if(abort || !busy) mac_issue<=0;
+        else if(ce) mac_issue<=state==READ_REQ;
+    end
+    mac_array_pipeline array_mac (.clk(clk),.rst_n(rst_n),.ce(ce),.abort(abort || !busy),
+        .in_valid(busy && mac_issue),.out_valid(mac_valid),
+        .activation_lanes(activations), .weight_lanes(weight_data),
+        .accumulator_lanes(512'd0), .result_lanes(next_accumulators), .overflow(mac_overflow));
+    genvar lane;
+    generate for(lane=0;lane<16;lane=lane+1) begin: accumulate_lanes
+        wire signed [32:0] total = {accumulators[lane*32+31],accumulators[lane*32 +: 32]}
+                                  + {next_accumulators[lane*32+31],next_accumulators[lane*32 +: 32]};
+        assign sum_accumulators[lane*32 +: 32]=total[31:0];
+        assign sum_overflow[lane]=total[32]^total[31];
+    end endgenerate
+    // Two II=1 pipelines process all sixteen channels in eight CE beats.
+    generate for (lane=0; lane<2; lane=lane+1) begin: requant_lanes
+        wire signed [7:0] q;
+        wire [3:0] channel={q_send,1'b0}+lane;
+        int8_requant_pipeline requant (.clk(clk),.rst_n(rst_n),.ce(ce),.abort(abort),
+            .in_valid(busy && state==QUANT),.out_valid(quant_valid[lane]),
+            .accumulator(accumulators[channel*32 +: 32]),
+            .multiplier(multipliers[channel*32 +: 32]), .shift(shifts[channel*6 +: 6]),
+            .relu(relu), .result(q), .error(quant_errors[lane]));
+        assign quant_results[lane*8 +: 8] = q;
+    end endgenerate
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            state<=IDLE; busy<=0; done<=0; error<=0; cycles<=0;
+            ci<=0; co<=0; width<=0; height<=0; ow<=0; oh<=0;
+            kernel<=0; stride<=0; padding<=0; ob<=0; ib<=0; blocks<=0;
+            ky<=0; kx<=0; oy<=0; ox<=0; relu<=0; limit_last<=0;
+            accumulators<=0; multipliers<=0; shifts<=0; quantized<=0; bias_latched<=0;
+            mac_pending<=0; q_send<=0; q_receive<=0;
+            padding_pixel<=0; input_row<=0; weight_row<=0; plane_words<=0;
+            pixel_row<=0; block_base<=0; output_address_low<=0; input_address<=0; weight_address<=0;
+        end else begin
+            if (busy) cycles<=cycles+1;
+            if(abort) begin busy<=0; done<=0; error<=0; state<=IDLE; end
+            else if (busy && cycles >= limit_last) begin
+                busy<=0; done<=0; error<=1; state<=IDLE;
+            end else if (ce && busy && mac_valid && mac_pending!=0
+                         && |((mac_overflow | sum_overflow) & active_outputs)) begin
+                busy<=0; done<=0; error<=1; state<=IDLE;
+            end else if (ce) begin
+                if(busy) begin
+                    if(mac_valid && mac_pending!=0) accumulators<=sum_accumulators;
+                    case({state==READ_REQ,mac_valid && mac_pending!=0})
+                        2'b10: mac_pending<=mac_pending+1;
+                        2'b01: mac_pending<=mac_pending-1;
+                        default: begin end
+                    endcase
+                end
+                case (state)
+                IDLE: if (start) begin
+                    done<=0; error<=0; cycles<=0;
+                    if (cfg_ci == 0 || cfg_ci > 64 || (cfg_ci != 1 && cfg_ci[2:0] != 0)
+                        || cfg_co == 0 || cfg_co > 64 || cfg_width == 0 || cfg_width > 64
+                        || cfg_height == 0 || cfg_height > 64
+                        || (cfg_kernel != 1 && cfg_kernel != 3)
+                        || (cfg_stride != 1 && cfg_stride != 2) || cfg_padding > 1
+                        || cfg_width+2*cfg_padding < cfg_kernel || cfg_height+2*cfg_padding < cfg_kernel
+                        || output_size(cfg_width,cfg_kernel,cfg_stride,cfg_padding) > 64
+                        || output_size(cfg_height,cfg_kernel,cfg_stride,cfg_padding) > 64
+                        || cfg_cycle_limit == 0) error<=1;
+                    else begin
+                        ci<=cfg_ci; co<=cfg_co; width<=cfg_width; height<=cfg_height;
+                        kernel<=cfg_kernel; stride<=cfg_stride; padding<=cfg_padding; relu<=cfg_relu;
+                        ow<=output_size(cfg_width,cfg_kernel,cfg_stride,cfg_padding);
+                        oh<=output_size(cfg_height,cfg_kernel,cfg_stride,cfg_padding);
+                        blocks<=cfg_ci == 1 ? 1 : cfg_ci >> 3;
+                        ob<=0; ib<=0; ky<=0; kx<=0; oy<=0; ox<=0;
+                        mac_pending<=0; q_send<=0; q_receive<=0;
+                        limit_last<=cfg_cycle_limit-32'd1; busy<=1; state<=SETUP;
+                    end
+                end
+                SETUP: begin plane_words<=ow*oh; state<=PARAM_REQ; end
+                PARAM_REQ: state<=PARAM_USE;
+                PARAM_USE: begin
+                    accumulators<=bias_data; bias_latched<=bias_data;
+                    multipliers<=multiplier_data; shifts<=shift_data;
+                    state<=GEOMETRY;
+                end
+                GEOMETRY: begin
+                    padding_pixel<=iy<0 || iy>=height || ix<0 || ix>=width;
+                    input_row<=ib*height+iy;
+                    weight_row<=(ob*kernel+ky)*kernel+kx;
+                    pixel_row<=oy*ow; block_base<={plane_words,1'b0}*ob;
+                    state<=ADDRESS_USE;
+                end
+                ADDRESS_USE: begin
+                    input_address<=padding_pixel ? 16'd0 : input_row*width+ix;
+                    weight_address<=weight_row*blocks+ib;
+                    output_address_low<=block_base+pixel_row+ox;
+                    state<=READ_REQ;
+                end
+                READ_REQ: begin
+                    if (ib+1 < blocks) begin ib<=ib+1; state<=GEOMETRY; end
+                    else begin
+                        ib<=0;
+                        if (kx+1 < kernel) begin kx<=kx+1; state<=GEOMETRY; end
+                        else begin
+                            kx<=0;
+                            if (ky+1 < kernel) begin ky<=ky+1; state<=GEOMETRY; end
+                            else begin ky<=0; state<=MAC_USE; end
+                        end
+                    end
+                end
+                MAC_USE: if(mac_valid && mac_pending==1) begin
+                    q_send<=0; q_receive<=0; state<=QUANT;
+                end
+                QUANT, QUANT_WAIT: begin
+                if(state==QUANT) begin
+                    q_send<=q_send+1;
+                    if(q_send==7) state<=QUANT_WAIT;
+                end
+                if(&quant_valid) begin
+                if (|(quant_errors & active_outputs[q_receive*2 +: 2])) begin
+                    busy<=0; done<=0; error<=1; state<=IDLE;
+                end else begin
+                    quantized[q_receive*16 +: 16] <= {
+                        active_outputs[q_receive*2+1] ? quant_results[15:8] : 8'd0,
+                        active_outputs[q_receive*2] ? quant_results[7:0] : 8'd0};
+                    q_receive<=q_receive+1;
+                    if(q_receive==7) state<=WRITE_LOW;
+                end
+                end
+                end
+                WRITE_LOW: state <= co > ob*16+8 ? WRITE_HIGH : ADVANCE;
+                WRITE_HIGH: state<=ADVANCE;
+                ADVANCE: begin
+                    if (ox+1 < ow) begin ox<=ox+1; accumulators<=bias_latched; state<=GEOMETRY; end
+                    else begin
+                        ox<=0;
+                        if (oy+1 < oh) begin oy<=oy+1; accumulators<=bias_latched; state<=GEOMETRY; end
+                        else begin
+                            oy<=0;
+                            if ((ob+1)*16 < co) begin ob<=ob+1; state<=PARAM_REQ; end
+                            else begin busy<=0; done<=1; state<=IDLE; end
+                        end
+                    end
+                end
+                default: begin busy<=0; done<=0; error<=1; state<=IDLE; end
+            endcase
+            end
+        end
+    end
+endmodule
diff --git a/data/logs/cnn-ooc-1cefffc05185438195b8803d87fc11df/inputs/int8_gap.v b/data/logs/cnn-ooc-1cefffc05185438195b8803d87fc11df/inputs/int8_gap.v
new file mode 100644
index 0000000..424a15c
--- /dev/null
+++ b/data/logs/cnn-ooc-1cefffc05185438195b8803d87fc11df/inputs/int8_gap.v
@@ -0,0 +1,12 @@
+`timescale 1ns/1ps
+// Caller supplies the complete sum of exactly 256 nonnegative INT8 values.
+module int8_gap (
+    input wire [31:0] total,
+    output wire signed [7:0] result,
+    output wire error
+);
+    wire [32:0] rounded;
+    assign error = total > 32512;
+    assign rounded = ({1'b0, total} + 33'd128) >> 8;
+    assign result = error ? 8'sd0 : rounded[7:0];
+endmodule
diff --git a/data/logs/cnn-ooc-1cefffc05185438195b8803d87fc11df/inputs/int8_logits.v b/data/logs/cnn-ooc-1cefffc05185438195b8803d87fc11df/inputs/int8_logits.v
new file mode 100644
index 0000000..dd8a401
--- /dev/null
+++ b/data/logs/cnn-ooc-1cefffc05185438195b8803d87fc11df/inputs/int8_logits.v
@@ -0,0 +1,28 @@
+`timescale 1ns/1ps
+module int8_logits (
+    input wire [23:0] logits,
+    input wire [7:0] min_margin,
+    output wire [1:0] class_id,
+    output wire [7:0] margin_q,
+    output wire [14:0] score_q15,
+    output wire low_conf,
+    output wire error
+);
+    wire signed [7:0] a, b, c, top1, top2;
+    wire [1:0] winner;
+    wire signed [8:0] difference;
+    wire [15:0] scaled;
+    assign a = logits[7:0]; assign b = logits[15:8]; assign c = logits[23:16];
+    assign error = a == -8'sd128 || b == -8'sd128 || c == -8'sd128;
+    assign winner = a >= b && a >= c ? 2'd0 : b >= c ? 2'd1 : 2'd2;
+    assign top1 = winner == 0 ? a : winner == 1 ? b : c;
+    assign top2 = winner == 0 ? (b >= c ? b : c)
+                : winner == 1 ? (a >= c ? a : c) : (a >= b ? a : b);
+    assign difference = {top1[7], top1} - {top2[7], top2};
+    assign margin_q = error ? 8'd0 : difference[7:0];
+    // Exact for 0..254: floor((m*32767+127)/254) = 129*m + (m>=127).
+    assign scaled = {1'b0,margin_q,7'd0}+{8'd0,margin_q}+(margin_q>=127 ? 16'd1 : 16'd0);
+    assign score_q15 = error ? 15'd0 : scaled[14:0];
+    assign class_id = error ? 2'd3 : winner;
+    assign low_conf = error || margin_q < min_margin;
+endmodule
diff --git a/data/logs/cnn-ooc-1cefffc05185438195b8803d87fc11df/inputs/int8_mac.v b/data/logs/cnn-ooc-1cefffc05185438195b8803d87fc11df/inputs/int8_mac.v
new file mode 100644
index 0000000..9d8025b
--- /dev/null
+++ b/data/logs/cnn-ooc-1cefffc05185438195b8803d87fc11df/inputs/int8_mac.v
@@ -0,0 +1,17 @@
+// C02 scalar arithmetic primitive; callers reject overflow, never saturate.
+// Legal model operands are signed INT8 [-127,127]; no storage or handshake.
+`timescale 1ns/1ps
+module int8_mac (
+    input wire signed [7:0] activation,
+    input wire signed [7:0] weight,
+    input wire signed [31:0] accumulator,
+    output wire signed [31:0] result,
+    output wire overflow
+);
+    wire signed [15:0] product;
+    wire signed [32:0] total;
+    assign product = activation * weight;
+    assign total = {accumulator[31], accumulator} + {{17{product[15]}}, product};
+    assign result = total[31:0];
+    assign overflow = total[32] ^ total[31];
+endmodule
diff --git a/data/logs/cnn-ooc-1cefffc05185438195b8803d87fc11df/inputs/int8_requant.v b/data/logs/cnn-ooc-1cefffc05185438195b8803d87fc11df/inputs/int8_requant.v
new file mode 100644
index 0000000..3fa857a
--- /dev/null
+++ b/data/logs/cnn-ooc-1cefffc05185438195b8803d87fc11df/inputs/int8_requant.v
@@ -0,0 +1,22 @@
+`timescale 1ns/1ps
+// C02: ReLU before requant; nearest rounding with half cases away from zero.
+module int8_requant (
+    input wire signed [31:0] accumulator,
+    input wire [31:0] multiplier,
+    input wire [5:0] shift,
+    input wire relu,
+    output wire signed [7:0] result,
+    output wire error
+);
+    wire signed [31:0] value;
+    wire signed [63:0] product;
+    wire [63:0] magnitude, rounded;
+    assign error = multiplier == 0 || multiplier[31] || shift == 63;
+    assign value = relu && accumulator[31] ? 32'sd0 : accumulator;
+    assign product = value * $signed(multiplier);
+    // Valid INT32 * positive INT32 never reaches INT64_MIN.
+    assign magnitude = product[63] ? -product : product;
+    assign rounded = shift == 0 ? magnitude : (magnitude + (64'd1 << (shift-1))) >> shift;
+    assign result = error ? 8'sd0 : rounded > 127 ? (product[63] ? -8'sd127 : 8'sd127)
+                   : product[63] ? -$signed(rounded[7:0]) : $signed(rounded[7:0]);
+endmodule
diff --git a/data/logs/cnn-ooc-1cefffc05185438195b8803d87fc11df/inputs/int8_requant_pipeline.v b/data/logs/cnn-ooc-1cefffc05185438195b8803d87fc11df/inputs/int8_requant_pipeline.v
new file mode 100644
index 0000000..48e9c3f
--- /dev/null
+++ b/data/logs/cnn-ooc-1cefffc05185438195b8803d87fc11df/inputs/int8_requant_pipeline.v
@@ -0,0 +1,36 @@
+`timescale 1ns/1ps
+// Four CE stages: signed multiply, absolute value, rounding add, shift/saturate.
+module int8_requant_pipeline (
+    input wire clk,rst_n,ce,abort,in_valid,
+    input wire signed [31:0] accumulator,
+    input wire [31:0] multiplier,
+    input wire [5:0] shift,
+    input wire relu,
+    output wire out_valid,
+    output reg signed [7:0] result,
+    output wire error
+);
+    reg [3:0] valid,errors;
+    reg signed [63:0] product;
+    reg [63:0] magnitude,biased;
+    reg [5:0] s0,s1,s2;
+    reg neg1,neg2;
+    wire signed [31:0] value=relu && accumulator[31] ? 32'sd0 : accumulator;
+    wire [63:0] rounded=s2==0 ? biased : biased>>s2;
+    always @(posedge clk or negedge rst_n) begin
+        if(!rst_n) begin valid<=0; errors<=0; end
+        else if(abort) begin valid<=0; errors<=0; end
+        else if(ce) begin
+            valid<={valid[2:0],in_valid};
+            errors<={errors[2:0],multiplier==0 || multiplier[31] || shift==63};
+        end
+    end
+    always @(posedge clk) if(ce) begin
+        product<=value*$signed(multiplier); s0<=shift;
+        magnitude<=product[63] ? -product : product; neg1<=product[63]; s1<=s0;
+        biased<=s1==0 ? magnitude : magnitude+(64'd1<<(s1-1)); neg2<=neg1; s2<=s1;
+        result<=errors[2] ? 8'sd0 : rounded>127 ? (neg2 ? -8'sd127 : 8'sd127)
+                : neg2 ? -$signed(rounded[7:0]) : $signed(rounded[7:0]);
+    end
+    assign out_valid=valid[3]; assign error=errors[3];
+endmodule
diff --git a/data/logs/cnn-ooc-1cefffc05185438195b8803d87fc11df/inputs/mac_array.v b/data/logs/cnn-ooc-1cefffc05185438195b8803d87fc11df/inputs/mac_array.v
new file mode 100644
index 0000000..e306781
--- /dev/null
+++ b/data/logs/cnn-ooc-1cefffc05185438195b8803d87fc11df/inputs/mac_array.v
@@ -0,0 +1,31 @@
+`timescale 1ns/1ps
+// C02: weights[out_lane16][in_lane8], in_lane varies fastest.
+// Combinational arithmetic only; a scheduler must register/validate the result.
+module mac_array (
+    input wire [63:0] activation_lanes,
+    input wire [1023:0] weight_lanes,
+    input wire [511:0] accumulator_lanes,
+    output wire [511:0] result_lanes,
+    output wire [15:0] overflow
+);
+    wire signed [31:0] products [0:127];
+    wire [127:0] product_overflow;
+    genvar o, i;
+    generate for (o = 0; o < 16; o = o + 1) begin: outputs
+        for (i = 0; i < 8; i = i + 1) begin: inputs
+            int8_mac cell_mac (
+                .activation(activation_lanes[i*8 +: 8]),
+                .weight(weight_lanes[(o*8+i)*8 +: 8]), .accumulator(32'sd0),
+                .result(products[o*8+i]), .overflow(product_overflow[o*8+i]));
+        end
+        // Eight products cannot overflow INT32; maximum magnitude is 129032.
+        wire signed [31:0] dot;
+        wire signed [32:0] total;
+        assign dot = products[o*8] + products[o*8+1] + products[o*8+2] + products[o*8+3]
+                   + products[o*8+4] + products[o*8+5] + products[o*8+6] + products[o*8+7];
+        assign total = {accumulator_lanes[o*32+31], accumulator_lanes[o*32 +: 32]}
+                     + {dot[31], dot};
+        assign result_lanes[o*32 +: 32] = total[31:0];
+        assign overflow[o] = total[32] ^ total[31];
+    end endgenerate
+endmodule
diff --git a/data/logs/cnn-ooc-1cefffc05185438195b8803d87fc11df/inputs/mac_array_pipeline.v b/data/logs/cnn-ooc-1cefffc05185438195b8803d87fc11df/inputs/mac_array_pipeline.v
new file mode 100644
index 0000000..7885d22
--- /dev/null
+++ b/data/logs/cnn-ooc-1cefffc05185438195b8803d87fc11df/inputs/mac_array_pipeline.v
@@ -0,0 +1,50 @@
+`timescale 1ns/1ps
+// Five CE stages: 128 DSP products, balanced 8-way sum, INT32 checked add.
+// Data registers need no reset; validity is cleared on reset/abort.
+module mac_array_pipeline (
+    input wire clk, rst_n, ce, abort, in_valid,
+    input wire [63:0] activation_lanes,
+    input wire [1023:0] weight_lanes,
+    input wire [511:0] accumulator_lanes,
+    output wire out_valid,
+    output wire [511:0] result_lanes,
+    output wire [15:0] overflow
+);
+    reg [4:0] valid;
+    reg [511:0] acc0, acc1, acc2, acc3;
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) valid<=0;
+        else if (abort) valid<=0;
+        else if (ce) valid<={valid[3:0],in_valid};
+    end
+    always @(posedge clk) if (ce) begin
+        acc0<=accumulator_lanes; acc1<=acc0; acc2<=acc1; acc3<=acc2;
+    end
+    assign out_valid=valid[4];
+    genvar o,i;
+    generate for(o=0;o<16;o=o+1) begin: lanes
+        (* use_dsp="yes" *) reg signed [15:0] products [0:7];
+        reg signed [16:0] pairs [0:3];
+        reg signed [17:0] quads [0:1];
+        reg signed [18:0] dot;
+        reg signed [32:0] total;
+        for(i=0;i<8;i=i+1) begin: multiply
+            always @(posedge clk) if(ce)
+                products[i]<=$signed(activation_lanes[i*8 +: 8])*$signed(weight_lanes[(o*8+i)*8 +: 8]);
+        end
+        for(i=0;i<4;i=i+1) begin: sum_pairs
+            always @(posedge clk) if(ce)
+                pairs[i]<={products[2*i][15],products[2*i]}+{products[2*i+1][15],products[2*i+1]};
+        end
+        for(i=0;i<2;i=i+1) begin: sum_quads
+            always @(posedge clk) if(ce)
+                quads[i]<={pairs[2*i][16],pairs[2*i]}+{pairs[2*i+1][16],pairs[2*i+1]};
+        end
+        always @(posedge clk) if(ce) begin
+            dot<={quads[0][17],quads[0]}+{quads[1][17],quads[1]};
+            total<={acc3[o*32+31],acc3[o*32 +: 32]}+{{14{dot[18]}},dot};
+        end
+        assign result_lanes[o*32 +: 32]=total[31:0];
+        assign overflow[o]=total[32]^total[31];
+    end endgenerate
+endmodule
