+    wire [63:0] write_data;
+    reg [63:0] input_data;
+    reg [1023:0] weight_data;
+    reg [511:0] bias_data,multiplier_data;
+    reg [95:0] shift_data;
+    reg [7:0] roi [0:4095];
+    reg [63:0] ping [0:4095],pong [0:2047],gap [0:7];
+    reg [1023:0] weights [0:268];
+    reg [31:0] biases [0:159],multipliers [0:159];
