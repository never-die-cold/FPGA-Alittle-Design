+        vvp "build/$name.vvp" || exit 1
+    fi
+done
+if [ "$MODE" = "all" ]; then
+    bash scripts/run_iverilog.sh coprocessor all || exit 1
+    bash scripts/run_coprocessor_python.sh all || exit 1
+    for bench_mode in bench_nofwd bench_fwd bench_bht1 bench_bht2; do
