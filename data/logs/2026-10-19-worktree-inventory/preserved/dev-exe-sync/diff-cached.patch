+    v1_hazard_fwd) TBS=(riscv/tb_core_v1_hazard.v); IVERILOG_ARGS=(-Ptb_core_v1_hazard.ENABLE_FORWARDING=1) ;;
+    v1_hazard_nofwd) TBS=(riscv/tb_core_v1_hazard.v); IVERILOG_ARGS=(-Ptb_core_v1_hazard.ENABLE_FORWARDING=0) ;;
