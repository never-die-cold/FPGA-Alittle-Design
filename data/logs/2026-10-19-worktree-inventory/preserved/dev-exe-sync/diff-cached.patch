+++ b/data/logs/cnn-ooc-da63cadcd3db4a9e9f826cf2e4949e68/inputs/run_cnn_ooc.ps1
@@ -0,0 +1,29 @@
+param([string]$Vivado='D:/Vivado_downloads/2026.1/Vivado/bin/vivado.bat')
+$ErrorActionPreference='Stop'
+$repo=[IO.Path]::GetFullPath((Join-Path $PSScriptRoot '../..'))
+if(!(Test-Path -LiteralPath $Vivado)){throw 'Vivado executable missing'}
+$evidence=Join-Path $repo ('data/logs/cnn-ooc-'+[guid]::NewGuid().ToString('N'))
+$inputs=Join-Path $evidence 'inputs'
+New-Item -ItemType Directory $inputs | Out-Null
+$records=@()
+$sources=@(Get-ChildItem (Join-Path $repo 'src/coprocessor') -Filter '*.v' -File)
+$sources+=Get-Item (Join-Path $PSScriptRoot 'synth_coprocessor_ooc.tcl'),$PSCommandPath
+foreach($source in $sources){
+    Copy-Item -LiteralPath $source.FullName -Destination (Join-Path $inputs $source.Name)
+    $records+=@{path=$source.FullName.Substring($repo.Length+1).Replace('\','/');
+        file=$source.Name;bytes=$source.Length;sha256=(Get-FileHash $source.FullName -Algorithm SHA256).Hash.ToLower()}
+}
+Push-Location $repo
+try {
+    @{git_base=(git rev-parse HEAD);uncommitted=$true;part='xc7z020clg400-1';clock_ns=10;
+        kind='CONTROLLER_ONLY_OOC_EXTERNAL_MEMORY_PORTS';files=$records} |
+        ConvertTo-Json -Depth 5 | Set-Content (Join-Path $evidence 'manifest.json') -Encoding utf8
+    Write-Output "EVIDENCE_DIR=$evidence"
+    & $Vivado -mode batch -source (Join-Path $inputs 'synth_coprocessor_ooc.tcl') `
+        -log (Join-Path $evidence 'vivado.log') -journal (Join-Path $evidence 'vivado.jou') `
+        -tclargs (Join-Path $evidence 'reports') $inputs $repo *> (Join-Path $evidence 'console.txt')
+    $rc=$LASTEXITCODE
+    Set-Content (Join-Path $evidence 'exit.txt') $rc
+    Get-Content (Join-Path $evidence 'console.txt') -Tail 20
+    exit $rc
+} finally {Pop-Location}
diff --git a/data/logs/cnn-ooc-da63cadcd3db4a9e9f826cf2e4949e68/inputs/synth_coprocessor_ooc.tcl b/data/logs/cnn-ooc-da63cadcd3db4a9e9f826cf2e4949e68/inputs/synth_coprocessor_ooc.tcl
new file mode 100644
index 0000000..7c472b8
--- /dev/null
+++ b/data/logs/cnn-ooc-da63cadcd3db4a9e9f826cf2e4949e68/inputs/synth_coprocessor_ooc.tcl
@@ -0,0 +1,41 @@
+# Reproducible default-Verilog OOC check of the CNN operator controller.
+set root [file normalize [file join [file dirname [info script]] ../..]]
+if {$argc != 2 && $argc != 3} { error "usage: output-directory source-snapshot-directory ?repository-root?" }
+if {$argc == 3} { set root [file normalize [lindex $argv 2]] }
+set out [file normalize [lindex $argv 0]]
+set sources [file normalize [lindex $argv 1]]
+foreach path [list $out $sources] {
+    if {![string match -nocase "$root/*" $path]} { error "path outside repository" }
+}
+if {[file exists $out] && [llength [glob -nocomplain -directory $out *]]} {
+    error "output must be new/empty; preserve previous reports"
+}
+file mkdir $out
+puts "VIVADO=[version -short] SOURCES=$sources"
+read_verilog [glob -directory $sources *.v]
+synth_design -top cnn_sequencer -part xc7z020clg400-1 -mode out_of_context
+create_clock -name cnn_clk -period 10.000 [get_ports clk]
+set_input_delay -clock cnn_clk 1.000 [get_ports -filter {DIRECTION == IN && NAME != clk && NAME != rst_n}]
+set_output_delay -clock cnn_clk 1.000 [all_outputs]
+set_false_path -from [get_ports rst_n]
+opt_design
+place_design
+phys_opt_design
+route_design
+report_utilization -file [file join $out utilization.rpt]
+report_timing_summary -warn_on_violation -file [file join $out timing.rpt]
+report_timing -max_paths 10 -file [file join $out worst_paths.rpt]
+report_drc -file [file join $out drc.rpt]
+check_timing -verbose
+write_checkpoint [file join $out cnn_ooc.dcp]
+set paths [get_timing_paths -delay_type max -max_paths 1]
+if {![llength $paths]} { error "no setup timing path" }
+set slack [get_property SLACK [lindex $paths 0]]
+set hold_paths [get_timing_paths -delay_type min -max_paths 1]
+if {![llength $hold_paths]} { error "no hold timing path" }
+set hold_slack [get_property SLACK [lindex $hold_paths 0]]
+set dsp [llength [get_cells -hierarchical -filter {REF_NAME =~ DSP48*}]]
+set severe [get_drc_violations -filter {SEVERITY == Error || SEVERITY == "Critical Warning"}]
