+    generate for (lane=0; lane<16; lane=lane+1) begin: requant_lanes
+        wire signed [7:0] q;
+        int8_requant_pipeline requant (.clk(clk),.rst_n(rst_n),.ce(ce),.abort(abort),
+            .in_valid(busy && state==QUANT),.out_valid(quant_valid[lane]),
+            .accumulator(accumulators[lane*32 +: 32]),
+            .multiplier(multipliers[lane*32 +: 32]), .shift(shifts[lane*6 +: 6]),
+            .relu(relu), .result(q), .error(quant_errors[lane]));
+        assign quant_results[lane*8 +: 8] = active_outputs[lane] ? q : 8'd0;
+    end endgenerate
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            state<=IDLE; busy<=0; done<=0; error<=0; cycles<=0;
+            ci<=0; co<=0; width<=0; height<=0; ow<=0; oh<=0;
+            kernel<=0; stride<=0; padding<=0; ob<=0; ib<=0; blocks<=0;
+            ky<=0; kx<=0; oy<=0; ox<=0; relu<=0; limit_last<=0;
+            accumulators<=0; multipliers<=0; shifts<=0; quantized<=0;
+            padding_pixel<=0; input_row<=0; weight_row<=0; plane_words<=0;
+            pixel_row<=0; block_base<=0; output_address_low<=0; input_address<=0; weight_address<=0;
+        end else begin
+            if (busy) cycles<=cycles+1;
+            if(abort) begin busy<=0; done<=0; error<=0; state<=IDLE; end
+            else if (busy && cycles >= limit_last) begin
+                busy<=0; done<=0; error<=1; state<=IDLE;
+            end else if (ce) case (state)
+                IDLE: if (start) begin
+                    done<=0; error<=0; cycles<=0;
+                    if (cfg_ci == 0 || cfg_ci > 64 || (cfg_ci != 1 && cfg_ci[2:0] != 0)
+                        || cfg_co == 0 || cfg_co > 64 || cfg_width == 0 || cfg_width > 64
+                        || cfg_height == 0 || cfg_height > 64
+                        || (cfg_kernel != 1 && cfg_kernel != 3)
+                        || (cfg_stride != 1 && cfg_stride != 2) || cfg_padding > 1
+                        || cfg_width+2*cfg_padding < cfg_kernel || cfg_height+2*cfg_padding < cfg_kernel
+                        || output_size(cfg_width,cfg_kernel,cfg_stride,cfg_padding) > 64
+                        || output_size(cfg_height,cfg_kernel,cfg_stride,cfg_padding) > 64
+                        || cfg_cycle_limit == 0) error<=1;
+                    else begin
+                        ci<=cfg_ci; co<=cfg_co; width<=cfg_width; height<=cfg_height;
+                        kernel<=cfg_kernel; stride<=cfg_stride; padding<=cfg_padding; relu<=cfg_relu;
+                        ow<=output_size(cfg_width,cfg_kernel,cfg_stride,cfg_padding);
+                        oh<=output_size(cfg_height,cfg_kernel,cfg_stride,cfg_padding);
+                        blocks<=cfg_ci == 1 ? 1 : cfg_ci >> 3;
+                        ob<=0; ib<=0; ky<=0; kx<=0; oy<=0; ox<=0;
+                        limit_last<=cfg_cycle_limit-32'd1; busy<=1; state<=SETUP;
+                    end
+                end
+                SETUP: begin plane_words<=ow*oh; state<=PARAM_REQ; end
+                PARAM_REQ: state<=PARAM_USE;
+                PARAM_USE: begin
+                    accumulators<=bias_data; multipliers<=multiplier_data; shifts<=shift_data;
+                    state<=GEOMETRY;
+                end
+                GEOMETRY: begin
+                    padding_pixel<=iy<0 || iy>=height || ix<0 || ix>=width;
+                    input_row<=ib*height+iy;
+                    weight_row<=(ob*kernel+ky)*kernel+kx;
+                    pixel_row<=oy*ow; block_base<={plane_words,1'b0}*ob;
+                    state<=ADDRESS_USE;
+                end
+                ADDRESS_USE: begin
+                    input_address<=padding_pixel ? 16'd0 : input_row*width+ix;
+                    weight_address<=weight_row*blocks+ib;
+                    output_address_low<=block_base+pixel_row+ox;
+                    state<=READ_REQ;
+                end
+                READ_REQ: state<=MAC_REQ;
+                MAC_REQ: state<=MAC_USE;
+                MAC_USE: if(mac_valid) begin
+                if (|(mac_overflow & active_outputs)) begin
+                    busy<=0; done<=0; error<=1; state<=IDLE;
+                end else begin
+                    accumulators<=next_accumulators;
+                    if (ib+1 < blocks) begin ib<=ib+1; state<=GEOMETRY; end
+                    else begin
+                        ib<=0;
+                        if (kx+1 < kernel) begin kx<=kx+1; state<=GEOMETRY; end
+                        else begin
+                            kx<=0;
+                            if (ky+1 < kernel) begin ky<=ky+1; state<=GEOMETRY; end
+                            else begin ky<=0; state<=QUANT; end
+                        end
+                    end
+                end
+                end
+                QUANT: state<=QUANT_WAIT;
+                QUANT_WAIT: if(&quant_valid) begin
+                if (|(quant_errors & active_outputs)) begin
+                    busy<=0; done<=0; error<=1; state<=IDLE;
+                end else begin quantized<=quant_results; state<=WRITE_LOW; end
+                end
+                WRITE_LOW: state <= co > ob*16+8 ? WRITE_HIGH : ADVANCE;
+                WRITE_HIGH: state<=ADVANCE;
+                ADVANCE: begin
+                    if (ox+1 < ow) begin ox<=ox+1; state<=PARAM_REQ; end
+                    else begin
+                        ox<=0;
+                        if (oy+1 < oh) begin oy<=oy+1; state<=PARAM_REQ; end
+                        else begin
+                            oy<=0;
+                            if ((ob+1)*16 < co) begin ob<=ob+1; state<=PARAM_REQ; end
+                            else begin busy<=0; done<=1; state<=IDLE; end
+                        end
+                    end
+                end
+                default: begin busy<=0; done<=0; error<=1; state<=IDLE; end
+            endcase
+        end
+    end
+endmodule
diff --git a/data/logs/cnn-ooc-4065cdcc415b43fbbc713dbeeceddbfb/inputs/int8_gap.v b/data/logs/cnn-ooc-4065cdcc415b43fbbc713dbeeceddbfb/inputs/int8_gap.v
new file mode 100644
index 0000000..424a15c
--- /dev/null
+++ b/data/logs/cnn-ooc-4065cdcc415b43fbbc713dbeeceddbfb/inputs/int8_gap.v
@@ -0,0 +1,12 @@
+`timescale 1ns/1ps
+// Caller supplies the complete sum of exactly 256 nonnegative INT8 values.
+module int8_gap (
+    input wire [31:0] total,
+    output wire signed [7:0] result,
+    output wire error
+);
+    wire [32:0] rounded;
+    assign error = total > 32512;
+    assign rounded = ({1'b0, total} + 33'd128) >> 8;
+    assign result = error ? 8'sd0 : rounded[7:0];
+endmodule
diff --git a/data/logs/cnn-ooc-4065cdcc415b43fbbc713dbeeceddbfb/inputs/int8_logits.v b/data/logs/cnn-ooc-4065cdcc415b43fbbc713dbeeceddbfb/inputs/int8_logits.v
new file mode 100644
index 0000000..dd8a401
--- /dev/null
+++ b/data/logs/cnn-ooc-4065cdcc415b43fbbc713dbeeceddbfb/inputs/int8_logits.v
@@ -0,0 +1,28 @@
+`timescale 1ns/1ps
+module int8_logits (
+    input wire [23:0] logits,
+    input wire [7:0] min_margin,
+    output wire [1:0] class_id,
+    output wire [7:0] margin_q,
+    output wire [14:0] score_q15,
+    output wire low_conf,
+    output wire error
+);
+    wire signed [7:0] a, b, c, top1, top2;
+    wire [1:0] winner;
+    wire signed [8:0] difference;
+    wire [15:0] scaled;
+    assign a = logits[7:0]; assign b = logits[15:8]; assign c = logits[23:16];
+    assign error = a == -8'sd128 || b == -8'sd128 || c == -8'sd128;
+    assign winner = a >= b && a >= c ? 2'd0 : b >= c ? 2'd1 : 2'd2;
+    assign top1 = winner == 0 ? a : winner == 1 ? b : c;
+    assign top2 = winner == 0 ? (b >= c ? b : c)
+                : winner == 1 ? (a >= c ? a : c) : (a >= b ? a : b);
+    assign difference = {top1[7], top1} - {top2[7], top2};
+    assign margin_q = error ? 8'd0 : difference[7:0];
+    // Exact for 0..254: floor((m*32767+127)/254) = 129*m + (m>=127).
+    assign scaled = {1'b0,margin_q,7'd0}+{8'd0,margin_q}+(margin_q>=127 ? 16'd1 : 16'd0);
+    assign score_q15 = error ? 15'd0 : scaled[14:0];
+    assign class_id = error ? 2'd3 : winner;
+    assign low_conf = error || margin_q < min_margin;
+endmodule
diff --git a/data/logs/cnn-ooc-4065cdcc415b43fbbc713dbeeceddbfb/inputs/int8_mac.v b/data/logs/cnn-ooc-4065cdcc415b43fbbc713dbeeceddbfb/inputs/int8_mac.v
new file mode 100644
index 0000000..9d8025b
--- /dev/null
+++ b/data/logs/cnn-ooc-4065cdcc415b43fbbc713dbeeceddbfb/inputs/int8_mac.v
@@ -0,0 +1,17 @@
+// C02 scalar arithmetic primitive; callers reject overflow, never saturate.
+// Legal model operands are signed INT8 [-127,127]; no storage or handshake.
+`timescale 1ns/1ps
+module int8_mac (
+    input wire signed [7:0] activation,
+    input wire signed [7:0] weight,
+    input wire signed [31:0] accumulator,
+    output wire signed [31:0] result,
+    output wire overflow
+);
+    wire signed [15:0] product;
+    wire signed [32:0] total;
+    assign product = activation * weight;
+    assign total = {accumulator[31], accumulator} + {{17{product[15]}}, product};
+    assign result = total[31:0];
+    assign overflow = total[32] ^ total[31];
+endmodule
diff --git a/data/logs/cnn-ooc-4065cdcc415b43fbbc713dbeeceddbfb/inputs/int8_requant.v b/data/logs/cnn-ooc-4065cdcc415b43fbbc713dbeeceddbfb/inputs/int8_requant.v
new file mode 100644
index 0000000..3fa857a
--- /dev/null
+++ b/data/logs/cnn-ooc-4065cdcc415b43fbbc713dbeeceddbfb/inputs/int8_requant.v
@@ -0,0 +1,22 @@
+`timescale 1ns/1ps
+// C02: ReLU before requant; nearest rounding with half cases away from zero.
+module int8_requant (
+    input wire signed [31:0] accumulator,
+    input wire [31:0] multiplier,
+    input wire [5:0] shift,
+    input wire relu,
+    output wire signed [7:0] result,
+    output wire error
+);
+    wire signed [31:0] value;
+    wire signed [63:0] product;
+    wire [63:0] magnitude, rounded;
+    assign error = multiplier == 0 || multiplier[31] || shift == 63;
+    assign value = relu && accumulator[31] ? 32'sd0 : accumulator;
+    assign product = value * $signed(multiplier);
+    // Valid INT32 * positive INT32 never reaches INT64_MIN.
+    assign magnitude = product[63] ? -product : product;
+    assign rounded = shift == 0 ? magnitude : (magnitude + (64'd1 << (shift-1))) >> shift;
+    assign result = error ? 8'sd0 : rounded > 127 ? (product[63] ? -8'sd127 : 8'sd127)
+                   : product[63] ? -$signed(rounded[7:0]) : $signed(rounded[7:0]);
+endmodule
diff --git a/data/logs/cnn-ooc-4065cdcc415b43fbbc713dbeeceddbfb/inputs/int8_requant_pipeline.v b/data/logs/cnn-ooc-4065cdcc415b43fbbc713dbeeceddbfb/inputs/int8_requant_pipeline.v
new file mode 100644
index 0000000..48e9c3f
--- /dev/null
+++ b/data/logs/cnn-ooc-4065cdcc415b43fbbc713dbeeceddbfb/inputs/int8_requant_pipeline.v
@@ -0,0 +1,36 @@
+`timescale 1ns/1ps
+// Four CE stages: signed multiply, absolute value, rounding add, shift/saturate.
+module int8_requant_pipeline (
+    input wire clk,rst_n,ce,abort,in_valid,
+    input wire signed [31:0] accumulator,
+    input wire [31:0] multiplier,
+    input wire [5:0] shift,
+    input wire relu,
+    output wire out_valid,
+    output reg signed [7:0] result,
+    output wire error
+);
+    reg [3:0] valid,errors;
+    reg signed [63:0] product;
+    reg [63:0] magnitude,biased;
+    reg [5:0] s0,s1,s2;
+    reg neg1,neg2;
+    wire signed [31:0] value=relu && accumulator[31] ? 32'sd0 : accumulator;
+    wire [63:0] rounded=s2==0 ? biased : biased>>s2;
+    always @(posedge clk or negedge rst_n) begin
+        if(!rst_n) begin valid<=0; errors<=0; end
+        else if(abort) begin valid<=0; errors<=0; end
+        else if(ce) begin
+            valid<={valid[2:0],in_valid};
+            errors<={errors[2:0],multiplier==0 || multiplier[31] || shift==63};
+        end
+    end
+    always @(posedge clk) if(ce) begin
+        product<=value*$signed(multiplier); s0<=shift;
+        magnitude<=product[63] ? -product : product; neg1<=product[63]; s1<=s0;
+        biased<=s1==0 ? magnitude : magnitude+(64'd1<<(s1-1)); neg2<=neg1; s2<=s1;
+        result<=errors[2] ? 8'sd0 : rounded>127 ? (neg2 ? -8'sd127 : 8'sd127)
+                : neg2 ? -$signed(rounded[7:0]) : $signed(rounded[7:0]);
+    end
+    assign out_valid=valid[3]; assign error=errors[3];
+endmodule
diff --git a/data/logs/cnn-ooc-4065cdcc415b43fbbc713dbeeceddbfb/inputs/mac_array.v b/data/logs/cnn-ooc-4065cdcc415b43fbbc713dbeeceddbfb/inputs/mac_array.v
new file mode 100644
index 0000000..e306781
--- /dev/null
+++ b/data/logs/cnn-ooc-4065cdcc415b43fbbc713dbeeceddbfb/inputs/mac_array.v
@@ -0,0 +1,31 @@
+`timescale 1ns/1ps
+// C02: weights[out_lane16][in_lane8], in_lane varies fastest.
+// Combinational arithmetic only; a scheduler must register/validate the result.
+module mac_array (
+    input wire [63:0] activation_lanes,
+    input wire [1023:0] weight_lanes,
+    input wire [511:0] accumulator_lanes,
+    output wire [511:0] result_lanes,
+    output wire [15:0] overflow
+);
+    wire signed [31:0] products [0:127];
+    wire [127:0] product_overflow;
+    genvar o, i;
+    generate for (o = 0; o < 16; o = o + 1) begin: outputs
+        for (i = 0; i < 8; i = i + 1) begin: inputs
+            int8_mac cell_mac (
+                .activation(activation_lanes[i*8 +: 8]),
+                .weight(weight_lanes[(o*8+i)*8 +: 8]), .accumulator(32'sd0),
+                .result(products[o*8+i]), .overflow(product_overflow[o*8+i]));
+        end
+        // Eight products cannot overflow INT32; maximum magnitude is 129032.
+        wire signed [31:0] dot;
+        wire signed [32:0] total;
+        assign dot = products[o*8] + products[o*8+1] + products[o*8+2] + products[o*8+3]
+                   + products[o*8+4] + products[o*8+5] + products[o*8+6] + products[o*8+7];
+        assign total = {accumulator_lanes[o*32+31], accumulator_lanes[o*32 +: 32]}
+                     + {dot[31], dot};
+        assign result_lanes[o*32 +: 32] = total[31:0];
+        assign overflow[o] = total[32] ^ total[31];
+    end endgenerate
+endmodule
diff --git a/data/logs/cnn-ooc-4065cdcc415b43fbbc713dbeeceddbfb/inputs/mac_array_pipeline.v b/data/logs/cnn-ooc-4065cdcc415b43fbbc713dbeeceddbfb/inputs/mac_array_pipeline.v
new file mode 100644
index 0000000..7885d22
--- /dev/null
+++ b/data/logs/cnn-ooc-4065cdcc415b43fbbc713dbeeceddbfb/inputs/mac_array_pipeline.v
@@ -0,0 +1,50 @@
+`timescale 1ns/1ps
+// Five CE stages: 128 DSP products, balanced 8-way sum, INT32 checked add.
+// Data registers need no reset; validity is cleared on reset/abort.
+module mac_array_pipeline (
+    input wire clk, rst_n, ce, abort, in_valid,
+    input wire [63:0] activation_lanes,
+    input wire [1023:0] weight_lanes,
+    input wire [511:0] accumulator_lanes,
+    output wire out_valid,
+    output wire [511:0] result_lanes,
+    output wire [15:0] overflow
+);
+    reg [4:0] valid;
+    reg [511:0] acc0, acc1, acc2, acc3;
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) valid<=0;
+        else if (abort) valid<=0;
+        else if (ce) valid<={valid[3:0],in_valid};
+    end
+    always @(posedge clk) if (ce) begin
+        acc0<=accumulator_lanes; acc1<=acc0; acc2<=acc1; acc3<=acc2;
+    end
+    assign out_valid=valid[4];
+    genvar o,i;
+    generate for(o=0;o<16;o=o+1) begin: lanes
+        (* use_dsp="yes" *) reg signed [15:0] products [0:7];
+        reg signed [16:0] pairs [0:3];
+        reg signed [17:0] quads [0:1];
+        reg signed [18:0] dot;
+        reg signed [32:0] total;
+        for(i=0;i<8;i=i+1) begin: multiply
+            always @(posedge clk) if(ce)
+                products[i]<=$signed(activation_lanes[i*8 +: 8])*$signed(weight_lanes[(o*8+i)*8 +: 8]);
+        end
+        for(i=0;i<4;i=i+1) begin: sum_pairs
+            always @(posedge clk) if(ce)
+                pairs[i]<={products[2*i][15],products[2*i]}+{products[2*i+1][15],products[2*i+1]};
+        end
+        for(i=0;i<2;i=i+1) begin: sum_quads
+            always @(posedge clk) if(ce)
+                quads[i]<={pairs[2*i][16],pairs[2*i]}+{pairs[2*i+1][16],pairs[2*i+1]};
+        end
+        always @(posedge clk) if(ce) begin
+            dot<={quads[0][17],quads[0]}+{quads[1][17],quads[1]};
+            total<={acc3[o*32+31],acc3[o*32 +: 32]}+{{14{dot[18]}},dot};
+        end
+        assign result_lanes[o*32 +: 32]=total[31:0];
+        assign overflow[o]=total[32]^total[31];
+    end endgenerate
+endmodule
diff --git a/data/logs/cnn-ooc-4065cdcc415b43fbbc713dbeeceddbfb/inputs/run_cnn_ooc.ps1 b/data/logs/cnn-ooc-4065cdcc415b43fbbc713dbeeceddbfb/inputs/run_cnn_ooc.ps1
new file mode 100644
