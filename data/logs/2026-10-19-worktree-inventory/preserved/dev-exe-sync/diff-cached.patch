+                    2: begin if(write_address>=2048) $fatal(1); pong[write_address]=write_data; end
+                    3: begin if(write_address>=8) $fatal(1); gap[write_address]=write_data; end
+                    default: $fatal(1);
+                endcase
+                visited[position]=1; written=written+1;
+            end
