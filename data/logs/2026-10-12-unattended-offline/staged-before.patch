diff --git a/data/evidence/2026-10-12-c01-exact-build-inputs/inputs/sim/scripts/prepare_hdmi_sources.py b/data/evidence/2026-10-12-c01-exact-build-inputs/inputs/sim/scripts/prepare_hdmi_sources.py
